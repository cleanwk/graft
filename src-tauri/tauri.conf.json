{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graft",
  "version": "0.0.1",
  "identifier": "dev.graft.rust.Graft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Graft",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A precise, fast Git client for macOS",
    "longDescription": "Graft preserves the productive Git workflows of IntelliJ in a focused Rust and Tauri desktop application.",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQkQ4MDZBNjUxNEI3MjkKUldRcHR4Umxhb0M5cXkyUTlZUGZjbHg4eDg3aStPTGZlVHpWTGZlcnZCVWtPcTRFcFBPUXRUMy8K",
      "endpoints": [
        "https://github.com/cleanwk/graft/releases/latest/download/latest.json"
      ]
    }
  }
}
