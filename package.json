{
  "name": "graft",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --target aarch64-apple-darwin",
    "check": "npm run version:check && npm run build && npm run test && cargo test --manifest-path src-tauri/Cargo.toml",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check"
  },
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "@tanstack/vue-virtual": "3.13.35",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "latest",
    "@tauri-apps/plugin-opener": "latest",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "pinia": "4.0.3",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "latest",
    "vue-tsc": "3.3.10"
  }
}
